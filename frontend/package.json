{
  "name": "agentharness-tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript/Ink terminal UI for AgentHarness — communicates with Python backend via JSON-RPC over stdio",
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "ink": "^5.0.0",
    "react": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0"
  }
}
