Screen {
    background: $background;
}

#conversation-panel {
    width: 1fr;
    height: 1fr;
    overflow-y: auto;
    scrollbar-color: $surface;
    scrollbar-color-hover: $primary;
}

#bottom-bar {
    dock: bottom;
    height: auto;
    layout: horizontal;
    background: $surface;
    border-top: solid $panel;
}

#tool-indicator {
    width: auto;
    padding: 0 1;
    color: $secondary;
    text-style: bold;
}

#job-indicator {
    width: auto;
    padding: 0 1;
    color: $text-muted;
}

#input-bar {
    width: 1fr;
    height: 3;
    border: none;
    background: transparent;
    color: $text;
}

#input-bar.--processing {
    color: $primary;
}

/* Right-side stats panel */
#stats-panel {
    width: 30;
    min-width: 30;
    max-width: 30;
    background: $surface;
    padding: 1 1;
    border-left: solid $panel;
}

/* Message cards */
MessageCard {
    margin: 0 1;
    padding: 0 1;
}

MessageCard.user {
    color: $text-muted;
    background: transparent;
}

MessageCard.assistant {
    color: $text;
}

/* Assistant messages get subtle background (D-04) */
MessageCard.--assistant-bg {
    background: $surface;
}

InlineToolCall {
    margin: 0 1 0 2;
    padding: 0 1;
    color: $secondary;
    text-style: italic;
}

InlineToolCall.--expanded {
    color: $text;
    background: $surface;
    border: solid $panel 50%;
}

Header {
    dock: top;
    background: $surface;
    color: $text;
}
